# Copie este arquivo para .env e preencha.

# API de afiliados da Shopee (mesmas do bot de promoções)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Telegram: pode ser o MESMO token do bot de promoções.
# TELEGRAM_CHAT_ID = o SEU chat pessoal (não o canal), pra os vídeos chegarem só pra você.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: com a chave, o Claude escreve o gancho e a fala de cada vídeo (bem melhor que as frases prontas)
ANTHROPIC_API_KEY=

# Ordem dos nichos (o robô reveza um por execução)
NICHOS=casa,tecnologia,moda,beleza,calcados
VIDEOS_POR_EXECUCAO=1

# Modo: ugc (vídeo pronto) | ia (storyboard + prompts pro YouTube Create) | ambos
MODO=ambos
# Opcional: gera o storyboard sozinho (Google AI Studio > Get API key). Sem ela, manda só os prompts.
GEMINI_API_KEY=
